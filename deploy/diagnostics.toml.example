# Extra read-only diagnostics for this appliance.
#
# Entries here appear in the Diagnostics console alongside the built-ins. They
# are executed with the argv given below — never through a shell — with the same
# 20 second timeout. Keep them read-only: this file is a debugging aid, not a
# remote-administration channel.
#
# Install to /etc/aeroos/diagnostics.toml.

# [[command]]
# name = "list-usb"
# label = "List USB devices"
# description = "Enumerate USB peripherals attached to the appliance."
# argv = ["lsusb"]
# category = "system"


# AeroOS Pi 4 hardware bring-up. Outputs remain disabled during this phase.
AEROOS_SIMULATOR=0
AEROOS_HARDWARE_CONFIG=/etc/aeroos/hardware.toml
AEROOS_ACTUATOR_MASTER_ENABLE=0
AEROOS_DEVELOPMENT_SESSION_MINUTES=30
AEROOS_DEVELOPMENT_MIST_LIMIT=2

# Operator and bounded-control defaults.
AEROOS_OPERATOR_PIN=CHANGE_ON_FIRST_BOOT
AEROOS_SPRAY_DURATION=2
AEROOS_SPRAY_INTERVAL=300
AEROOS_MANUAL_SPRAY_LIMIT=2
AEROOS_MINIMUM_FLOW_LPM=0.2
AEROOS_DOSING_PULSE_ML=1
AEROOS_DOSING_HOURLY_LIMIT_ML=5
AEROOS_DOSING_DAILY_LIMIT_ML=20

# Network exposure. The kiosk uses loopback; change only behind a trusted boundary.
AEROOS_BIND_HOST=127.0.0.1
AEROOS_BIND_PORT=8080

# Operator session: reads stay valid all shift, actuator commands need a PIN
# entered within the elevation window.
AEROOS_ELEVATION_SECONDS=300

# Reliability and SD-card longevity.
AEROOS_SENSOR_TIMEOUT=5
AEROOS_RETENTION_DAYS=30
AEROOS_RETENTION_INTERVAL=3600

# Diagnostics console.
AEROOS_DIAGNOSTICS_EXTRA=/etc/aeroos/diagnostics.toml
AEROOS_CAMERA_GATE_DIR=/var/lib/aeroos/camera-gate

# AI assistance. Keys live in /etc/aeroos/gemini.env (mode 0600).
AEROOS_GEMINI_ENV=/etc/aeroos/gemini.env
AEROOS_GEMINI_MODEL=gemini-2.5-flash

# WiFi provisioning.
AEROOS_WIFI_INTERFACE=wlan0

# AeroOS AI assistance — Gemini API keys.
#
# Install to /etc/aeroos/gemini.env with mode 0600. The control service reads
# this file once at start-up; the keys are never returned by the API, written to
# the audit log, or included in an error message.
#
# Free-tier keys are rate limited per project. Supply up to four and AeroOS
# rotates between them, resting any key that reports a quota error rather than
# failing the operator's request.
#
# Get keys from https://aistudio.google.com/apikey
#
# AI assistance stays OFF until an operator enables it in Settings, because every
# request sends chamber telemetry and log excerpts to Google.

AEROOS_GEMINI_KEYS=

# Optional. Defaults to gemini-2.5-flash.
# AEROOS_GEMINI_MODEL=gemini-2.5-flash

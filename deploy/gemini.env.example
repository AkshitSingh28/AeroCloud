# AeroOS AI assistance — Gemini API keys.
#
# Install to /etc/aeroos/gemini.env as 0640 root:aeroos — the service runs as
# the aeroos user and must be able to read it. It reads the file once at
# start-up; the keys are never returned by the API, written to the audit log, or
# included in an error message.
#
# Free-tier keys are rate limited per project. Supply up to four and AeroOS
# rotates between them, resting any key that reports a quota error rather than
# failing the operator's request.
#
# Get keys from https://aistudio.google.com/apikey
#
# AI assistance stays OFF until an operator enables it in Settings, because every
# request sends chamber telemetry and log excerpts to Google.

AEROOS_GEMINI_KEYS=

# Optional. Defaults to gemini-3.6-flash.
#
# Google retires models and gates older ones to existing accounts, so a model
# that works today can start returning 404 for a new key. If assistance stops
# with "Model ... is unavailable", pin a current one here and restart aeroos.
# To see what a key can reach:
#   curl -s -H "x-goog-api-key: YOUR_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
# AEROOS_GEMINI_MODEL=gemini-3.6-flash
